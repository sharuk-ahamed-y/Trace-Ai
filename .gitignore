# ==============================================================================
# Transformation-Aware Image Provenance Graph Reconstruction — .gitignore
# Prevents uploading copyrighted images, trained binaries, & environment files
# ==============================================================================

# ── User & Generated Images (Copyright Protection) ───────────────────────────
data/originals/*
!data/originals/.gitkeep

data/generated/*
!data/generated/.gitkeep

data/labels/*
!data/labels/.gitkeep

data/uploads/*
!data/uploads/.gitkeep

data/reports/*.html
data/reports/*
!data/reports/.gitkeep

data/visualizations/*
!data/visualizations/.gitkeep

data/cache/

data/dev_isolated_test/
data/empirical_benchmark/
data/provenance_dataset_v2/
data/real_world_benchmark/
data/temp_test/
data/tmp_test/
image_provenance_dataset/features/

# Ignore any loose image files in root or data
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.tiff

# ── Trained Model Binaries & Caches ───────────────────────────────────────────
models/*
!models/.gitkeep
*.pt
*.pth
*.pkl
*.onnx
*.h5
*.bin
*.npy
*.npz

# ── Archives & Compressed Datasets ───────────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ── Output Graphs & Reports ───────────────────────────────────────────────────
outputs/*
!outputs/.gitkeep
*.csv
*.json

# Explicitly allow dataset metadata CSV & config JSON files
!DATASET_SOURCES.csv
!**/package.json
!**/package-lock.json
!**/tsconfig*.json

# ── Python & Environment ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environment
.venv/
venv/
ENV/
env/

# Environment secrets
.env
.env.*
!.env.example

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Node / JS & Frontend Build
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm/

# Database & Logs
*.db
*.sqlite
*.sqlite3
*.log

# Backups & Temporary Scratch
*.bak
*.bak*
*.backup
backend/backup/
scratch/

# TRACE AI 2.0: explicitly track project metadata/config
!DATASET_SOURCES.csv
!**/manifest.csv
!**/labels.csv
!**/config.json
!**/package.json
!**/package-lock.json
!**/tsconfig*.json
